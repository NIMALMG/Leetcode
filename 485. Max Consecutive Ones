class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int maxc = 0;
        int cnt = 0;
        for(int i = 0;i<nums.length;i++){
            if(nums[i]==1){
                cnt++;
                maxc = Math.max(maxc, cnt);
            }
            else{
                cnt=0;
            }

        }



        return maxc;
        
    }
}
