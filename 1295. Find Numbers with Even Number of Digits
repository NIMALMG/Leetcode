class Solution {
    public int findNumbers(int[] nums) {
        int evencount = 0;
        for(int i = 0;i<nums.length;i++){
            int n = nums[i];
            int digitcnt = 0;
            do{
                n/=10;
                digitcnt++;
            }
            while(n!=0);
            if(digitcnt%2==0){
                evencount++;
            }
        }
        return evencount;
    }
}
